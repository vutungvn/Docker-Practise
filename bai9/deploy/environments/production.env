# Production - environment-specific, NON-secret settings (reviewed in PRs like code).
# Secrets (DB_PASSWORD) live in the GitHub Environment "production", never here.

APP_REPLICAS=2
STARTUP_DELAY_SECONDS=2

# Post-deploy verification: stricter than staging (30 s x 30 req/s = ~900 samples; fast fail after 5 s).
# Kept to 30 s so the whole pipeline stays under its 10-minute budget.
VERIFY_SECONDS=30
VERIFY_RPS=30
MAX_ERROR_RATE=0.01
MAX_P95_MS=400
MIN_REQUESTS=650
