# Staging - environment-specific, NON-secret settings (reviewed in PRs like code).
# Secrets (DB_PASSWORD) live in the GitHub Environment "staging", never here.

APP_REPLICAS=1
STARTUP_DELAY_SECONDS=2

# Post-deploy verification: the release is rolled back automatically if any criterion fails.
VERIFY_SECONDS=20
VERIFY_RPS=20
MAX_ERROR_RATE=0.02
MAX_P95_MS=500
MIN_REQUESTS=300
